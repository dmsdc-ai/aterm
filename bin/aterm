#!/usr/bin/env bash
# aterm — CLI for aterm internal workspace communication
# Sends NDJSON over $ATERM_IPC_SOCKET. Falls back to telepty outside aterm.
set -euo pipefail

# Ensure aterm Resources/bin is in PATH (survives shell PATH reset)
if [ -n "${ATERM_RESOURCES_BIN:-}" ] && [ -d "$ATERM_RESOURCES_BIN" ]; then
    case ":$PATH:" in
        *":$ATERM_RESOURCES_BIN:"*) ;;
        *) export PATH="$ATERM_RESOURCES_BIN:$PATH" ;;
    esac
fi

ATERM_IPC_SOCKET="${ATERM_IPC_SOCKET:-}"

detect_ui_lang() {
    local raw="${ATERM_UI_LANG:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}"
    raw="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
    case "$raw" in
        ko*|*ko_*|*ko-*) echo "ko" ;;
        *) echo "en" ;;
    esac
}

ATERM_UI_LANG="$(detect_ui_lang)"
export ATERM_UI_LANG

# State directory for task board and lessons
STATE_DIR="${PWD}/state"
SETTINGS_FILE="${ATERM_DATA_ROOT:-${HOME}/.aigentry}/config/aterm.json"

tasks_file() { echo "${STATE_DIR}/task-queue.json"; }
lessons_file() { echo "${STATE_DIR}/lessons.json"; }

ensure_state_dir() { mkdir -p "$STATE_DIR"; }

ensure_tasks_file() {
    ensure_state_dir
    local f; f="$(tasks_file)"
    [ -f "$f" ] || echo '{"tasks":[],"completed":[]}' > "$f"
}

ensure_lessons_file() {
    ensure_state_dir
    local f; f="$(lessons_file)"
    [ -f "$f" ] || echo '{"invariants":[],"failed":[]}' > "$f"
}

print_ecosystem_status() {
    local ko="no"
    [ "$ATERM_UI_LANG" = "ko" ] && ko="yes"
    _probe_component() {
        # $1 = probe command on PATH, $2 = display label
        local mark msg
        if command -v "$1" >/dev/null 2>&1; then
            mark="✅"
            if [ "$ko" = "yes" ]; then msg="설치됨"; else msg="installed"; fi
        else
            mark="❌"
            if [ "$ko" = "yes" ]; then msg="미설치"; else msg="not installed"; fi
        fi
        printf '%s: %s %s\n' "$2" "$mark" "$msg"
    }
    _probe_component aigentry-brain        brain
    _probe_component telepty               telepty
    _probe_component aigentry-deliberation deliberation
    _probe_component aigentry-devkit       devkit
}

show_help() {
    if [ "$ATERM_UI_LANG" = "ko" ]; then
        cat <<'HELP'
# aterm — AI 네이티브 터미널 세션 통신

## 명령어

| 명령어 | 설명 |
|--------|------|
| `aterm list` | 워크스페이스 목록 표시 (`이름`, `CLI`, `경로`, `터미널`) |
| `aterm inject <workspace> <text>` | 워크스페이스에 텍스트 전송 |
| `aterm status` | 번들된 에코시스템 상태 표시 |
| `aterm status <workspace>` | 워크스페이스 상태 확인 |
| `aterm focus <workspace>` | 워크스페이스 탭으로 포커스 이동 |
| `aterm rename <old> <new>` | 워크스페이스 이름 변경 |
| `aterm clear <workspace>` | 워크스페이스 터미널 화면 초기화 |
| `aterm create <name> --cli <cli> --cwd <path>` | 새 워크스페이스 생성 |
| `aterm restart <workspace>` | 죽은 세션 재시작 |
| `aterm kill <workspace>` | 워크스페이스 종료 |
| `aterm restart-all` | 죽은 세션 전체 재시작 |
| `aterm tasks` | 대기 중인 태스크 목록 표시 |
| `aterm tasks add '<description>'` | 새 태스크 추가 |
| `aterm tasks done <id>` | 태스크 완료 처리 |
| `aterm lessons` | 기록된 교훈 표시 |
| `aterm lessons add '<lesson>'` | 교훈 추가 (`invariant`) |
| `aterm lessons add '<lesson>' --type failed` | 실패 패턴 추가 |
| `aterm dispatch <task-id>` | 태스크 분해 → 서브세션 생성 → 실행 → 수집 → 정리 |
| `aterm dispatch --plan '<desc>'` | 자유 텍스트 태스크 → 동일한 dispatch 흐름 |
| `aterm log <workspace> [--lines N]` | 워크스페이스 화면 텍스트 읽기 (기본 100줄) |
| `aterm export <workspace> [--format md\|txt]` | 세션 출력을 파일로 저장 |
| `aterm settings get <key>` | 설정 값 읽기 (~/.aigentry/config/aterm.json) |
| `aterm settings set <key> <value>` | 설정 값 변경 |
| `aterm theme <name>` | 테마 변경 (colorScheme 설정 단축키) |
| `aterm attach <external-id>` | 외부 세션 연결 |
| `aterm send-key <workspace> <key>` | 키 전송 (ctrl+c, enter, tab, esc 등) |
| `aterm subscribe [--events e1,e2]` | 워크스페이스 이벤트 실시간 스트림 (Created,Closed,StatusChanged,TitleChanged) |
| `aterm help` | 이 도움말 표시 |

## 에코시스템

✅ brain (AI 프로필 관리) — 이미 설치됨  
✅ telepty (터미널 간 통신) — 이미 설치됨  
✅ deliberation (멀티 AI 토론) — 이미 설치됨  
✅ devkit (워크스페이스 부트스트랩) — 이미 설치됨

## 자연어 → 명령어 매핑

### 내부 세션 (같은 aterm, `$ATERM_IPC_SOCKET` 설정됨)
| English request | 한국어 요청 | 명령어 |
|----------------|------------|--------|
| `list sessions` | `세션 목록 보여줘` | `aterm list` |
| `send build to ghostty` | `ghostty에 빌드 실행해줘` | `aterm inject ghostty 'make build'` |
| `check cmux status` | `cmux 세션 상태 확인해줘` | `aterm status cmux` |
| `show tasks` | `태스크 목록 보여줘` | `aterm tasks` |
| `add task: implement API` | `태스크 추가해줘: API 구현` | `aterm tasks add 'API 구현'` |
| `task 42 done` | `태스크 42 완료` | `aterm tasks done 42` |
| `show lessons` | `레슨 보여줘` | `aterm lessons` |
| `add lesson: this pattern failed` | `레슨 추가` | `aterm lessons add 'this pattern failed'` |
| `show session log` | `세션 로그 보여줘` | `aterm log myworkspace` |
| `export session output` | `세션 출력 저장해줘` | `aterm export myworkspace --format md` |
| `change theme` | `테마 변경해줘` | `aterm theme solarized` |
| `read setting` | `설정 확인해줘` | `aterm settings get colorScheme` |
| `attach external session` | `외부 세션 연결해줘` | `aterm attach ext-session-1` |
| `send ctrl+c` | `ctrl+c 보내줘` | `aterm send-key myworkspace ctrl+c` |

### 외부 세션 (다른 터미널/머신, `$ATERM_IPC_SOCKET` 미설정)
| English request | 한국어 요청 | 명령어 |
|----------------|------------|--------|
| `list external sessions` | `외부 세션 목록` | `telepty list` |
| `message deliberation session` | `deliberation 세션에 메시지 보내줘` | `telepty inject aigentry-deliberation-claude 'message'` |

## 세션 탐지 우선순위
1. `aterm list` — 내부 세션 (프로젝트 이름 + `terminal=aterm`)
2. `telepty list` — 외부 세션 (프로젝트 이름 + 터미널 타입)
3. `ps aux | grep` 를 주 탐지 수단으로 사용하지 말 것 (프로젝트 이름과 터미널 정보가 없음)

## 통신 방법 결정

| 상황 | 방법 |
|------|------|
| 대상 미지정 | 현재 세션에서 응답 (기본) |
| 대상이 내부 워크스페이스 | `aterm inject` |
| 대상이 외부 세션 | `telepty inject` |
| 대상이 자기 자신 | 경고 (`--force`로 강제 실행) |

## 탐지 규칙
- `$ATERM_IPC_SOCKET` 이 설정되어 있으면 aterm 내부입니다. `aterm` 명령을 사용합니다.
- `$ATERM_IPC_SOCKET` 이 비어 있으면 aterm 외부입니다. `telepty` 명령을 사용합니다.
- `aterm` 은 `list`/`inject`/`status` 에서 자동으로 `telepty` 로 폴백합니다.
HELP
    else
        cat <<'HELP'
# aterm — AI-native terminal session communication

## Commands

| Command | Description |
|---------|-------------|
| `aterm list` | List workspaces (`NAME`, `CLI`, `CWD`, `TERMINAL`) |
| `aterm inject <workspace> <text>` | Send text to a workspace |
| `aterm status` | Show bundled ecosystem health |
| `aterm status <workspace>` | Check workspace status |
| `aterm focus <workspace>` | Focus a workspace tab |
| `aterm rename <old> <new>` | Rename a workspace |
| `aterm clear <workspace>` | Clear workspace terminal screen |
| `aterm create <name> --cli <cli> --cwd <path>` | Create a new workspace |
| `aterm restart <workspace>` | Restart a dead session |
| `aterm kill <workspace>` | Close a workspace |
| `aterm restart-all` | Restart all dead sessions |
| `aterm tasks` | List pending tasks |
| `aterm tasks add '<description>'` | Add a new task |
| `aterm tasks done <id>` | Mark a task as completed |
| `aterm lessons` | List recorded lessons |
| `aterm lessons add '<lesson>'` | Add a lesson (`invariant`) |
| `aterm lessons add '<lesson>' --type failed` | Add a failed pattern |
| `aterm dispatch <task-id>` | Break down task -> create sub-sessions -> execute -> collect -> cleanup |
| `aterm dispatch --plan '<desc>'` | Free-text task -> same dispatch flow |
| `aterm log <workspace> [--lines N]` | Read workspace screen text (default 100 lines) |
| `aterm export <workspace> [--format md\|txt]` | Save session output to file |
| `aterm settings get <key>` | Read setting from ~/.aigentry/config/aterm.json |
| `aterm settings set <key> <value>` | Write setting to aterm.json |
| `aterm theme <name>` | Change theme (shortcut for settings set colorScheme) |
| `aterm attach <external-id>` | Attach an external session |
| `aterm send-key <workspace> <key>` | Send key to workspace (ctrl+c, enter, tab, esc, etc.) |
| `aterm subscribe [--events e1,e2]` | Stream workspace events in real-time (Created,Closed,StatusChanged,TitleChanged) |
| `aterm help` | Show this help |

## Ecosystem

✅ brain (AI profile management) — already installed  
✅ telepty (cross-terminal communication) — already installed  
✅ deliberation (multi-AI discussions) — already installed  
✅ devkit (workspace bootstrapping) — already installed

## Natural Language -> Command Mapping

### Internal sessions (same aterm, `$ATERM_IPC_SOCKET` set)
| English request | Korean request | Command |
|----------------|----------------|---------|
| `list sessions` | `세션 목록 보여줘` | `aterm list` |
| `send build to ghostty` | `ghostty에 빌드 실행해줘` | `aterm inject ghostty 'make build'` |
| `check cmux status` | `cmux 세션 상태 확인해줘` | `aterm status cmux` |
| `show tasks` | `태스크 목록 보여줘` | `aterm tasks` |
| `add task: implement API` | `태스크 추가해줘: API 구현` | `aterm tasks add 'API 구현'` |
| `task 42 done` | `태스크 42 완료` | `aterm tasks done 42` |
| `show lessons` | `레슨 보여줘` | `aterm lessons` |
| `add lesson: this pattern failed` | `레슨 추가` | `aterm lessons add 'this pattern failed'` |
| `show session log` | `세션 로그 보여줘` | `aterm log myworkspace` |
| `export session output` | `세션 출력 저장해줘` | `aterm export myworkspace --format md` |
| `change theme` | `테마 변경해줘` | `aterm theme solarized` |
| `read setting` | `설정 확인해줘` | `aterm settings get colorScheme` |
| `attach external session` | `외부 세션 연결해줘` | `aterm attach ext-session-1` |
| `send ctrl+c` | `ctrl+c 보내줘` | `aterm send-key myworkspace ctrl+c` |

### External sessions (other terminal or machine, `$ATERM_IPC_SOCKET` unset)
| English request | Korean request | Command |
|----------------|----------------|---------|
| `list external sessions` | `외부 세션 목록` | `telepty list` |
| `message deliberation session` | `deliberation 세션에 메시지 보내줘` | `telepty inject aigentry-deliberation-claude 'message'` |

## Session Detection Priority
1. `aterm list` — internal sessions (project names + `terminal=aterm`)
2. `telepty list` — external sessions (project names + terminal type)
3. Never use `ps aux | grep` as the primary detection method (no project names, no terminal info)

## Communication Decision

| Situation | Method |
|-----------|--------|
| No target specified | Reply in current session (default) |
| Target is internal workspace | `aterm inject` |
| Target is external session | `telepty inject` |
| Target is self | Warning (use `--force` to proceed) |

## Detection Rules
- `$ATERM_IPC_SOCKET` set -> inside aterm. Use `aterm` commands.
- `$ATERM_IPC_SOCKET` unset -> outside aterm. Use `telepty` commands.
- `aterm` automatically falls back to `telepty` for `list`, `inject`, and `status`.
HELP
    fi
}

aterm_ipc() {
    python3 -c '
import os, socket, sys, json

sock_path = sys.argv[1]
action = sys.argv[2]
args = sys.argv[3:]
lang = os.environ.get("ATERM_UI_LANG", "en")

payloads = {
    "list":        lambda: {"action": "ListWorkspaces"},
    "inject":      lambda: {"action": "Inject", "workspace": args[0],
                            "text": " ".join(args[1:]),
                            "from": __import__("os").environ.get("ATERM_WORKSPACE_NAME")},
    "inject-force": lambda: {"action": "Inject", "workspace": args[0],
                            "text": " ".join(args[1:]),
                            "from": __import__("os").environ.get("ATERM_WORKSPACE_NAME"),
                            "force": True},
    "status":      lambda: {"action": "WorkspaceStatus", "workspace": args[0]},
    "focus":       lambda: {"action": "FocusWorkspace", "workspace": args[0]},
    "rename":      lambda: {"action": "RenameWorkspace", "old_name": args[0], "new_name": args[1]},
    "clear":       lambda: {"action": "ClearWorkspace", "workspace": args[0]},
    "create":      lambda: {"action": "CreateWorkspace", "name": args[0], "cli": args[1], "cwd": args[2]},
    "kill":        lambda: {"action": "CloseWorkspace", "workspace": args[0]},
    "restart":     lambda: {"action": "RestartWorkspace", "workspace": args[0]},
    "restart-all": lambda: {"action": "RestartAllWorkspaces"},
    "reload-settings": lambda: {"action": "ReloadSettings"},
    "read-screen":     lambda: {"action": "ReadScreenText", "workspace": args[0],
                                "lines": int(args[1]) if len(args) > 1 else 100},
    "attach-external": lambda: {"action": "AttachExternal", "session_id": args[0]},
    "send-key":        lambda: {"action": "SendKey", "workspace": args[0], "key": args[1]},
    "change-cli":      lambda: {"action": "ChangeWorkspaceCLI", "workspace": args[0], "cli": args[1]},
}

payload = json.dumps(payloads[action]()) + "\n"

sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
try:
    sock.settimeout(5)
    sock.connect(sock_path)
    sock.sendall(payload.encode())
    sock.shutdown(socket.SHUT_WR)
    data = b""
    while True:
        chunk = sock.recv(4096)
        if not chunk:
            break
        data += chunk
        if b"\n" in data:
            break
    resp = json.loads(data.decode().strip().split("\n")[0])

    if resp.get("status") == "Error":
        print(json.dumps({"error": resp["message"]}), file=sys.stderr)
        sys.exit(1)
    elif action == "list":
        if __import__("os").environ.get("ATERM_LIST_JSON"):
            sessions = [
                session for session in resp.get("data", [])
                if session.get("status") not in ("dead", "closing")
            ]
            print(json.dumps({"sessions": sessions}))
        else:
            sessions = [
                session for session in resp.get("data", [])
                if session.get("status") not in ("dead", "closing")
            ]
            if not sessions:
                print("(워크스페이스 없음)" if lang == "ko" else "(no workspaces)")
            else:
                import os.path
                rows = []
                for s in sessions:
                    name = s.get("name") or os.path.basename(s.get("cwd", "")) or s.get("id", "?")
                    cli = s.get("cli", "")
                    cwd = s.get("cwd", "")
                    terminal = s.get("terminal", "aterm")
                    rows.append((name, cli, cwd, terminal))
                cols = ["이름", "CLI", "경로", "터미널"] if lang == "ko" else ["NAME", "CLI", "CWD", "TERMINAL"]
                widths = [max(len(c), *(len(r[i]) for r in rows)) for i, c in enumerate(cols)]
                fmt = "  ".join(f"{{:<{w}}}" for w in widths)
                print(fmt.format(*cols))
                print("  ".join("\u2500" * w for w in widths))
                for r in rows:
                    print(fmt.format(*r))
    elif action == "status":
        print(json.dumps(resp.get("data", {})))
    elif action == "read-screen":
        text = resp.get("data", {}).get("text", "") if isinstance(resp.get("data"), dict) else ""
        if text:
            print(text)
        else:
            print("(비어있음)" if lang == "ko" else "(empty)")
    else:
        print(json.dumps({"status": "ok"}))
except Exception as e:
    print(json.dumps({"error": str(e)}), file=sys.stderr)
    sys.exit(1)
finally:
    sock.close()
' "$ATERM_IPC_SOCKET" "$@"
}

# Early guard: handle commands when outside aterm ($ATERM_IPC_SOCKET not set)
case "${1:-help}" in
    help|--help|-h|version|--version)
        show_help
        exit 0 ;;
esac
if [ -z "$ATERM_IPC_SOCKET" ]; then
    _has_telepty() { command -v telepty >/dev/null 2>&1; }
    _no_telepty_msg() {
        if [ "$ATERM_UI_LANG" = "ko" ]; then
            echo 'Error: telepty를 찾을 수 없습니다. 설치: npm i -g @dmsdc-ai/telepty' >&2
        else
            echo 'Error: telepty not found. Install: npm i -g @dmsdc-ai/telepty' >&2
        fi
        exit 1
    }
    _app_required_msg() {
        if [ "$ATERM_UI_LANG" = "ko" ]; then
            echo "Error: 이 명령은 aterm 앱이 필요합니다. aterm.app을 먼저 실행하세요." >&2
        else
            echo "Error: This command requires aterm app. Run aterm.app first." >&2
        fi
        exit 1
    }
    case "${1:-help}" in
        inject)
            _has_telepty || _no_telepty_msg
            shift
            exec telepty inject "$@" ;;
        list)
            # Fall through to main case below — list ALWAYS merges union
            # (internal via /tmp/aterm-*.sock discovery + telepty). No early
            # short-circuit to telepty-only.
            ;;
        status)
            if [ "$#" -le 1 ]; then
                print_ecosystem_status
                exit 0
            fi
            _has_telepty || _no_telepty_msg
            shift
            exec telepty status "$@" ;;
        tasks|lessons|settings|theme)
            ;; # file-based commands — no IPC needed, fall through
        *)
            _app_required_msg ;;
    esac
fi

case "${1:-help}" in
    list)
        # Parse flags: --all (default), --internal-only, --telepty-only, --json
        shift
        _list_mode="all"
        _list_json=false
        while [ $# -gt 0 ]; do
            case "$1" in
                --all)           _list_mode="all"; shift ;;
                --internal-only) _list_mode="internal"; shift ;;
                --telepty-only)  _list_mode="telepty"; shift ;;
                --json)          _list_json=true; shift ;;
                *)               shift ;;  # ignore unknown
            esac
        done
        ATERM_LIST_MODE="$_list_mode" ATERM_LIST_JSON_FLAG="$_list_json" python3 -c '
import json, os, subprocess, glob
import socket as S

mode = os.environ.get("ATERM_LIST_MODE", "all")
json_out = os.environ.get("ATERM_LIST_JSON_FLAG", "false") == "true"
lang = os.environ.get("ATERM_UI_LANG", "en")

sessions = []

def query_aterm_socket(sock_path):
    """Query a single aterm IPC socket for workspaces. Returns list of dicts or []."""
    out = []
    try:
        s = S.socket(S.AF_UNIX, S.SOCK_STREAM)
        s.settimeout(2)
        s.connect(sock_path)
        s.sendall(json.dumps({"action": "ListWorkspaces"}).encode() + b"\n")
        s.shutdown(S.SHUT_WR)
        data = b""
        while True:
            chunk = s.recv(4096)
            if not chunk: break
            data += chunk
            if b"\n" in data: break
        s.close()
        resp = json.loads(data.decode().strip().split("\n")[0])
        for ws in resp.get("data", []):
            if ws.get("status") in ("dead", "closing"):
                continue
            ws["terminal"] = "aterm"
            ws["source"] = "internal"
            ws.setdefault("name", os.path.basename(ws.get("cwd", "")) or ws.get("id", "?"))
            out.append(ws)
    except Exception:
        pass
    return out

# 1. aterm internal sessions — discover socket if needed
if mode in ("all", "internal"):
    sock = os.environ.get("ATERM_IPC_SOCKET", "")
    if sock and os.path.exists(sock):
        sessions.extend(query_aterm_socket(sock))
    else:
        # Socket discovery: glob /tmp/aterm-*.sock, try each until one responds
        for candidate in glob.glob("/tmp/aterm-*.sock"):
            got = query_aterm_socket(candidate)
            if got:
                sessions.extend(got)
                break  # first responsive socket wins

