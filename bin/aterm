obj[parts[-1]] = val
with open(f, "w") as fh:
    json.dump(data, fh, indent=2, ensure_ascii=False)
    fh.write("\n")
print(json.dumps({"status": "ok", "key": key, "value": val}))
' "$3" "$4"
                if [ -n "$ATERM_IPC_SOCKET" ]; then
                    aterm_ipc reload-settings 2>/dev/null || true
                fi ;;
            *) echo '{"error":"usage: aterm settings [get|set]"}' >&2; exit 1 ;;
        esac ;;
    theme)
        [ "$#" -lt 2 ] && { echo '{"error":"usage: aterm theme <name>"}' >&2; exit 1; }
        python3 -c '
import json, sys, os
f = os.environ.get("ATERM_DATA_ROOT", os.path.expanduser("~/.aigentry")) + "/config/aterm.json"
os.makedirs(os.path.dirname(f), exist_ok=True)
data = {}
if os.path.isfile(f):
    with open(f) as fh:
        data = json.load(fh)
data["colorScheme"] = sys.argv[1]
with open(f, "w") as fh:
    json.dump(data, fh, indent=2, ensure_ascii=False)
    fh.write("\n")
print(json.dumps({"status": "ok", "key": "colorScheme", "value": sys.argv[1]}))
' "$2"
        if [ -n "$ATERM_IPC_SOCKET" ]; then
            aterm_ipc reload-settings 2>/dev/null || true
        fi ;;
    log)
        [ -z "$ATERM_IPC_SOCKET" ] && { echo '{"error":"log requires aterm (ATERM_IPC_SOCKET not set)"}' >&2; exit 1; }
        [ "$#" -lt 2 ] && { echo '{"error":"usage: aterm log <workspace> [--lines N]"}' >&2; exit 1; }
        _ws="$2"; _lines=100
        if [ "${3:-}" = "--lines" ] && [ -n "${4:-}" ]; then _lines="$4"; fi
        aterm_ipc read-screen "$_ws" "$_lines" ;;
    export)
        [ -z "$ATERM_IPC_SOCKET" ] && { echo '{"error":"export requires aterm (ATERM_IPC_SOCKET not set)"}' >&2; exit 1; }
        [ "$#" -lt 2 ] && { echo '{"error":"usage: aterm export <workspace> [--format md|txt]"}' >&2; exit 1; }
        _ws="$2"; _fmt="txt"
        if [ "${3:-}" = "--format" ] && [ -n "${4:-}" ]; then _fmt="$4"; fi
        python3 -c '
import os, socket, sys, json, time

sock_path = sys.argv[1]
workspace = sys.argv[2]
fmt = sys.argv[3]

payload = json.dumps({"action": "ReadScreenText", "workspace": workspace, "lines": 10000}) + "\n"
sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
try:
    sock.settimeout(5)
    sock.connect(sock_path)
    sock.sendall(payload.encode())
    sock.shutdown(socket.SHUT_WR)
    data = b""
    while True:
        chunk = sock.recv(4096)
        if not chunk: break
        data += chunk
        if b"\n" in data: break
    resp = json.loads(data.decode().strip().split("\n")[0])
finally:
    sock.close()

text = resp.get("data", {}).get("text", "") if isinstance(resp.get("data"), dict) else ""
ts = time.strftime("%Y%m%d-%H%M%S")
filename = f"{workspace}-{ts}.{fmt}"

if fmt == "md":
    content = f"# Session Export: {workspace}\n\n```\n{text}\n```\n"
else:
    content = text

with open(filename, "w") as f:
    f.write(content)
print(json.dumps({"status": "ok", "file": os.path.abspath(filename)}))
' "$ATERM_IPC_SOCKET" "$_ws" "$_fmt" ;;
    attach)
        [ -z "$ATERM_IPC_SOCKET" ] && { echo '{"error":"attach requires aterm (ATERM_IPC_SOCKET not set)"}' >&2; exit 1; }
        [ "$#" -lt 2 ] && { echo '{"error":"usage: aterm attach <external-id>"}' >&2; exit 1; }
        aterm_ipc attach-external "$2" ;;
    send-key)
        [ -z "$ATERM_IPC_SOCKET" ] && { echo '{"error":"send-key requires aterm (ATERM_IPC_SOCKET not set)"}' >&2; exit 1; }
        [ "$#" -lt 3 ] && { echo '{"error":"usage: aterm send-key <workspace> <key>"}' >&2; exit 1; }
        aterm_ipc send-key "$2" "$3" ;;
    cli)
        [ -z "$ATERM_IPC_SOCKET" ] && { echo '{"error":"cli requires aterm (ATERM_IPC_SOCKET not set)"}' >&2; exit 1; }
        [ "$#" -lt 3 ] && { echo '{"error":"usage: aterm cli <workspace> <new-cli>"}' >&2; exit 1; }
        aterm_ipc change-cli "$2" "$3" ;;
    subscribe)
        [ -z "$ATERM_IPC_SOCKET" ] && { echo '{"error":"subscribe requires aterm (ATERM_IPC_SOCKET not set)"}' >&2; exit 1; }
        # Parse --events flag
        _events="[]"
        shift
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --events) _events="$2"; shift 2 ;;
                *) shift ;;
            esac
        done
        python3 -c '
import os, socket, sys, json, signal

sock_path = sys.argv[1]
raw_events = sys.argv[2]

# Parse events: comma-separated string → JSON array
if raw_events == "[]":
    events = []
else:
    events = [e.strip() for e in raw_events.split(",") if e.strip()]

payload = json.dumps({"action": "Subscribe", "events": events}) + "\n"

sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
try:
    sock.connect(sock_path)
    sock.sendall(payload.encode())

    # Read initial OK response (first line)
    buf = b""
    while b"\n" not in buf:
        chunk = sock.recv(4096)
        if not chunk:
            print(json.dumps({"error": "connection closed before response"}), file=sys.stderr)
            sys.exit(1)
        buf += chunk

    first_line, remainder = buf.split(b"\n", 1)
    resp = json.loads(first_line.decode())
    if resp.get("status") == "Error":
        print(json.dumps({"error": resp.get("message", "subscribe failed")}), file=sys.stderr)
        sys.exit(1)

    # Stream events (NDJSON) until interrupted or connection closed
    # Process any data already in remainder
    buf = remainder
    while True:
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            line = line.strip()
            if line:
                print(line.decode(), flush=True)
        try:
            chunk = sock.recv(4096)
        except (KeyboardInterrupt, BrokenPipeError):
            break
        if not chunk:
            break
        buf += chunk
except KeyboardInterrupt:
    pass
except Exception as e:
    print(json.dumps({"error": str(e)}), file=sys.stderr)
    sys.exit(1)
finally:
    sock.close()
' "$ATERM_IPC_SOCKET" "$_events" ;;
    help|--help|-h)
        show_help
        ;;
    *) echo "{\"error\":\"unknown command: $1\"}" >&2; exit 1 ;;
esac
