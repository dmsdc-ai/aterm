#!/usr/bin/env bash
# aterm — CLI for aterm internal workspace communication
# Sends NDJSON over $ATERM_IPC_SOCKET. Falls back to telepty outside aterm.
set -euo pipefail

ATERM_IPC_SOCKET="${ATERM_IPC_SOCKET:-}"

# State directory for task board and lessons
STATE_DIR="${PWD}/state"

tasks_file() { echo "${STATE_DIR}/task-queue.json"; }
lessons_file() { echo "${STATE_DIR}/lessons.json"; }

ensure_state_dir() { mkdir -p "$STATE_DIR"; }

ensure_tasks_file() {
    ensure_state_dir
    local f; f="$(tasks_file)"
    [ -f "$f" ] || echo '{"tasks":[],"completed":[]}' > "$f"
}

ensure_lessons_file() {
    ensure_state_dir
    local f; f="$(lessons_file)"
    [ -f "$f" ] || echo '{"invariants":[],"failed":[]}' > "$f"
}

print_ecosystem_status() {
    cat <<'STATUS'
brain: ✅ installed
telepty: ✅ installed
deliberation: ✅ installed
devkit: ✅ installed
STATUS
}

aterm_ipc() {
    python3 -c '
import socket, sys, json

sock_path = sys.argv[1]
action = sys.argv[2]
args = sys.argv[3:]

payloads = {
    "list":   lambda: {"action": "ListWorkspaces"},
    "inject": lambda: {"action": "Inject", "workspace": args[0],
                        "text": " ".join(args[1:]),
                        "from": __import__("os").environ.get("ATERM_WORKSPACE_NAME")},
    "status": lambda: {"action": "WorkspaceStatus", "workspace": args[0]},
    "focus":  lambda: {"action": "FocusWorkspace", "workspace": args[0]},
}

payload = json.dumps(payloads[action]()) + "\n"

sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
try:
    sock.settimeout(5)
    sock.connect(sock_path)
    sock.sendall(payload.encode())
    sock.shutdown(socket.SHUT_WR)
    data = b""
    while True:
        chunk = sock.recv(4096)
        if not chunk:
            break
        data += chunk
        if b"\n" in data:
            break
    resp = json.loads(data.decode().strip().split("\n")[0])

    if resp.get("status") == "Error":
        print(json.dumps({"error": resp["message"]}), file=sys.stderr)
        sys.exit(1)
    elif action == "list":
        if __import__("os").environ.get("ATERM_LIST_JSON"):
            print(json.dumps({"sessions": resp.get("data", [])}))
        else:
            sessions = resp.get("data", [])
            if not sessions:
                print("(no workspaces)")
            else:
                import os.path
                rows = []
                for s in sessions:
                    name = s.get("name") or os.path.basename(s.get("cwd", "")) or s.get("id", "?")
                    cli = s.get("cli", "")
                    cwd = s.get("cwd", "")
                    terminal = s.get("terminal", "aterm")
                    rows.append((name, cli, cwd, terminal))
                cols = ["NAME", "CLI", "CWD", "TERMINAL"]
                widths = [max(len(c), *(len(r[i]) for r in rows)) for i, c in enumerate(cols)]
                fmt = "  ".join(f"{{:<{w}}}" for w in widths)
                print(fmt.format(*cols))
                print("  ".join("\u2500" * w for w in widths))
                for r in rows:
                    print(fmt.format(*r))
    elif action == "status":
        print(json.dumps(resp.get("data", {})))
    else:
        print(json.dumps({"status": "ok"}))
except Exception as e:
    print(json.dumps({"error": str(e)}), file=sys.stderr)
    sys.exit(1)
finally:
    sock.close()
' "$ATERM_IPC_SOCKET" "$@"
}

case "${1:-help}" in
    list)
        if [[ "${2:-}" == "--json" ]]; then
            # JSON mode: output merged JSON
            python3 -c '
import json, sys, os, subprocess, os.path

sessions = []

# 1. aterm internal sessions
sock = os.environ.get("ATERM_IPC_SOCKET", "")
if sock:
    import socket as S
    try:
        s = S.socket(S.AF_UNIX, S.SOCK_STREAM)
        s.settimeout(5)
        s.connect(sock)
        s.sendall(json.dumps({"action": "ListWorkspaces"}).encode() + b"\n")
        s.shutdown(S.SHUT_WR)
        data = b""
        while True:
            chunk = s.recv(4096)
            if not chunk: break
            data += chunk
            if b"\n" in data: break
        s.close()
        resp = json.loads(data.decode().strip().split("\n")[0])
        for ws in resp.get("data", []):
            ws["terminal"] = "aterm"
            ws.setdefault("name", os.path.basename(ws.get("cwd", "")) or ws.get("id", "?"))
            sessions.append(ws)
    except: pass

# 2. telepty external sessions (only if installed)
try:
    result = subprocess.run(["telepty", "list", "--json"], capture_output=True, text=True, timeout=5)
    if result.returncode == 0:
        tdata = json.loads(result.stdout)
        for ts in (tdata if isinstance(tdata, list) else tdata.get("sessions", [])):
            ts.setdefault("terminal", ts.get("terminal", "external"))
            ts.setdefault("name", ts.get("id", "?"))
            sessions.append(ts)
except (FileNotFoundError, subprocess.TimeoutExpired, json.JSONDecodeError): pass

print(json.dumps({"sessions": sessions}))
'
        else
            # Table mode: merged display
            python3 -c '
import json, sys, os, subprocess, os.path

sessions = []

# 1. aterm internal sessions
sock = os.environ.get("ATERM_IPC_SOCKET", "")
if sock:
    import socket as S
    try:
        s = S.socket(S.AF_UNIX, S.SOCK_STREAM)
        s.settimeout(5)
        s.connect(sock)
        s.sendall(json.dumps({"action": "ListWorkspaces"}).encode() + b"\n")
        s.shutdown(S.SHUT_WR)
        data = b""
        while True:
            chunk = s.recv(4096)
            if not chunk: break
            data += chunk
            if b"\n" in data: break
        s.close()
        resp = json.loads(data.decode().strip().split("\n")[0])
        for ws in resp.get("data", []):
            name = ws.get("name") or os.path.basename(ws.get("cwd", "")) or ws.get("id", "?")
            cli = ws.get("cli", "")
            cwd = ws.get("cwd", "")
            sessions.append((name, cli, cwd, "aterm"))
    except: pass

# 2. telepty external sessions (only if installed)
try:
    result = subprocess.run(["telepty", "list", "--json"], capture_output=True, text=True, timeout=5)
    if result.returncode == 0:
        tdata = json.loads(result.stdout)
        for ts in (tdata if isinstance(tdata, list) else tdata.get("sessions", [])):
            name = ts.get("name") or ts.get("id", "?")
            cli = ts.get("cli", "")
            cwd = ts.get("cwd", "")
            terminal = ts.get("terminal", "external")
            sessions.append((name, cli, cwd, terminal))
except (FileNotFoundError, subprocess.TimeoutExpired, json.JSONDecodeError): pass

if not sessions:
    print("(no reachable sessions)")
else:
    cols = ["NAME", "CLI", "CWD", "TERMINAL"]
    widths = [max(len(c), *(len(r[i]) for r in sessions)) for i, c in enumerate(cols)]
    fmt = "  ".join(f"{{:<{w}}}" for w in widths)
    print(fmt.format(*cols))
    print("  ".join("\u2500" * w for w in widths))
    for r in sessions:
        print(fmt.format(*r))
    if all(r[3] == "aterm" for r in sessions):
        print()
        print("💡 All sessions are aterm-internal. Install telepty for cross-terminal: already included!")
'
        fi ;;
    inject)
        if [[ -z "$ATERM_IPC_SOCKET" ]]; then exec telepty inject "${@:2}"; fi
        [[ $# -lt 3 ]] && { echo '{"error":"usage: aterm inject <workspace> <text>"}' >&2; exit 1; }
        aterm_ipc inject "${@:2}" ;;
    status)
        if [[ $# -eq 1 ]]; then
            print_ecosystem_status
            exit 0
        fi
        if [[ -z "$ATERM_IPC_SOCKET" ]]; then exec telepty status "${@:2}"; fi
        [[ $# -lt 2 ]] && { echo '{"error":"usage: aterm status <workspace>"}' >&2; exit 1; }
        aterm_ipc status "$2" ;;
    focus)
        [[ -z "$ATERM_IPC_SOCKET" ]] && { echo '{"error":"focus requires aterm (ATERM_IPC_SOCKET not set)"}' >&2; exit 1; }
        [[ $# -lt 2 ]] && { echo '{"error":"usage: aterm focus <workspace>"}' >&2; exit 1; }
        aterm_ipc focus "$2" ;;
    tasks)
        ensure_tasks_file
        case "${2:-list}" in
            list)
                python3 -c '
import json, sys
with open(sys.argv[1]) as f: data = json.load(f)
if not data.get("tasks"):
    print("No pending tasks.")
    sys.exit(0)
for i, t in enumerate(data["tasks"]):
    tid = t.get("id", i)
    desc = t.get("description", t) if isinstance(t, dict) else t
    print(f"  [{tid}] {desc}")
' "$(tasks_file)" ;;
            add)
                [[ $# -lt 3 ]] && { echo '{"error":"usage: aterm tasks add <description>"}' >&2; exit 1; }
                python3 -c '
import json, sys, time
f = sys.argv[1]; desc = " ".join(sys.argv[2:])
with open(f) as fh: data = json.load(fh)
tid = int(time.time() * 1000) % 100000
data["tasks"].append({"id": tid, "description": desc})
with open(f, "w") as fh: json.dump(data, fh, indent=2, ensure_ascii=False); fh.write("\n")
print(json.dumps({"status":"ok","id": tid}))
' "$(tasks_file)" "${@:3}" ;;
            done)
                [[ $# -lt 3 ]] && { echo '{"error":"usage: aterm tasks done <id>"}' >&2; exit 1; }
                python3 -c '
import json, sys
f = sys.argv[1]; target = int(sys.argv[2])
with open(f) as fh: data = json.load(fh)
found = None
for i, t in enumerate(data["tasks"]):
    tid = t.get("id", i) if isinstance(t, dict) else i
    if tid == target:
        found = data["tasks"].pop(i)
        break
if not found:
    print(json.dumps({"error": f"task {target} not found"}), file=sys.stderr); sys.exit(1)
data.setdefault("completed", []).append(found)
with open(f, "w") as fh: json.dump(data, fh, indent=2, ensure_ascii=False); fh.write("\n")
print(json.dumps({"status":"ok","id": target}))
' "$(tasks_file)" "$3" ;;
            *) echo '{"error":"usage: aterm tasks [list|add|done]"}' >&2; exit 1 ;;
        esac ;;
    lessons)
        ensure_lessons_file
        case "${2:-list}" in
            list)
                python3 -c '
import json, sys
with open(sys.argv[1]) as f: data = json.load(f)
inv = data.get("invariants", [])
fail = data.get("failed", [])
if not inv and not fail:
    print("No lessons recorded.")
    sys.exit(0)
if inv:
    print("Invariants:")
    for l in inv: print(f"  - {l}")
if fail:
    print("Failed patterns:")
    for l in fail: print(f"  - {l}")
' "$(lessons_file)" ;;
            add)
                [[ $# -lt 3 ]] && { echo '{"error":"usage: aterm lessons add <lesson> [--type invariant|failed]"}' >&2; exit 1; }
                python3 -c '
import json, sys
f = sys.argv[1]; lesson = sys.argv[2]
ltype = "invariants"
if "--type" in sys.argv:
    idx = sys.argv.index("--type")
    if idx + 1 < len(sys.argv) and sys.argv[idx+1] == "failed":
        ltype = "failed"
with open(f) as fh: data = json.load(fh)
data.setdefault(ltype, []).append(lesson)
with open(f, "w") as fh: json.dump(data, fh, indent=2, ensure_ascii=False); fh.write("\n")
print(json.dumps({"status":"ok","type": ltype}))
' "$(lessons_file)" "${@:3}" ;;
            *) echo '{"error":"usage: aterm lessons [list|add]"}' >&2; exit 1 ;;
        esac ;;
    help|--help|-h)
        cat <<'HELP'
# aterm — AI-native terminal session communication

## Commands

| Command | Description |
|---------|-------------|
| `aterm list` | List workspaces (NAME, CLI, CWD, TERMINAL) |
| `aterm inject <workspace> <text>` | Send text to a workspace |
| `aterm status` | Show bundled ecosystem health |
| `aterm status <workspace>` | Check workspace status |
| `aterm focus <workspace>` | Focus a workspace tab |
| `aterm tasks` | List pending tasks |
| `aterm tasks add '<description>'` | Add a new task |
| `aterm tasks done <id>` | Mark task as completed |
| `aterm lessons` | List recorded lessons |
| `aterm lessons add '<lesson>'` | Add a lesson (invariant) |
| `aterm lessons add '<lesson>' --type failed` | Add a failed pattern |
| `aterm help` | Show this help |

## Ecosystem

✅ brain (AI profile management) — already installed  
✅ telepty (cross-terminal communication) — already installed  
✅ deliberation (multi-AI discussions) — already installed  
✅ devkit (workspace bootstrapping) — already installed

## Natural Language → Command Mapping

### Internal sessions (same aterm, $ATERM_IPC_SOCKET set)
| Natural language | Command |
|-----------------|---------|
| 'list sessions' / '세션 목록 보여줘' | `aterm list` |
| 'send build to ghostty' / 'ghostty에 빌드 실행해줘' | `aterm inject ghostty 'make build'` |
| 'check cmux status' / 'cmux 세션 상태 확인해줘' | `aterm status cmux` |
| 'show tasks' / '태스크 목록 보여줘' | `aterm tasks` |
| 'add task: implement API' / '태스크 추가해줘: API 구현' | `aterm tasks add 'API 구현'` |
| 'task 42 done' / '태스크 42 완료' | `aterm tasks done 42` |
| 'show lessons' / '레슨 보여줘' | `aterm lessons` |
| 'add lesson: this pattern failed' / '레슨 추가' | `aterm lessons add 'this pattern failed'` |

### External sessions (other terminal/machine, $ATERM_IPC_SOCKET unset)
| Natural language | Command |
|-----------------|---------|
| 'list external sessions' / '외부 세션 목록' | `telepty list` |
| 'message deliberation session' | `telepty inject aigentry-deliberation-claude 'message'` |

## Session Detection Priority
1. `aterm list` — internal sessions (project names + terminal=aterm)
2. `telepty list` — external sessions (project names + terminal type)
3. NEVER use `ps aux | grep` as primary (no project names, no terminal info)

## Detection Rules
- `$ATERM_IPC_SOCKET` set → inside aterm. Use `aterm` commands.
- `$ATERM_IPC_SOCKET` unset → outside aterm. Use `telepty` commands.
- `aterm` falls back to `telepty` automatically for list/inject/status.
HELP
        ;;
    *) echo "{\"error\":\"unknown command: $1\"}" >&2; exit 1 ;;
esac
